#!name=淘金币每日任务
#!desc=手机淘宝淘金币每日自动签到。自动捕获并学习 mtop 签到接口与会话 Cookie，通过原生纯 JS MD5 计算动态签名与 Token 续签舞步。每天 09:18 自动签到，自带体检与手动测试入口。
#!arguments=capture:淘金币抓包
#!arguments-desc=Cookie 抓包默认开启（参数值即脚本名）。在手机淘宝打开「淘金币」页面点一次签到即可自动捕获接口与凭据；锁定成功后把参数改成 # 即可关闭抓包。
#!category=自动任务

[Script]
# 1. 淘金币接口与凭据抓包 (自动分级锁定 rank3 签到接口，合并 Cookie 池，捕获成功弹通知)
{{{capture}}} = type=http-request,pattern=^https:\/\/(h5api|h5|api|acs)\.m\.taobao\.com\/(h5\/|gw\/),requires-body=true,max-size=262144,script-path=https://raw.githubusercontent.com/Viceroy-Dennis/surge-modules/main/taobao/taobao_capture.js,script-update-interval=0

# 2. 定时自动签到任务 (每天 09:18 自动执行)
淘金币自动签到 = type=cron,cronexp=18 9 * * *,timeout=60,script-path=https://raw.githubusercontent.com/Viceroy-Dennis/surge-modules/main/taobao/taobao_task.js,script-update-interval=0

# 3. 手动执行与体检入口 (在 Surge 脚本列表直接点击)
淘金币手动执行 = type=generic,timeout=60,script-path=https://raw.githubusercontent.com/Viceroy-Dennis/surge-modules/main/taobao/taobao_task.js,script-update-interval=0
淘金币体检测试 = type=generic,timeout=60,script-path=https://raw.githubusercontent.com/Viceroy-Dennis/surge-modules/main/taobao/taobao_test.js,script-update-interval=0

[MITM]
hostname = %APPEND% h5api.m.taobao.com, h5.m.taobao.com, api.m.taobao.com, acs.m.taobao.com
