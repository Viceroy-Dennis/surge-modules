#!name=蜗牛4K每日签到
#!desc=蜗牛 I 4K（wn4k.com）每日签到。零配置用法：浏览器登录 wn4k.com 后打开一次「会员中心」任意页面，Cookie 自动捕获并顺手补签；之后每天 09:14 自动签到。也可在模块参数里填账号密码（Cookie 过期时自动重登）。
#!arguments=account:none
#!arguments-desc=account：填「账号,密码」走账号密码登录（多个账号用 && 分隔，如 a@qq.com,p1&&b@qq.com,p2）；留 none 表示只用抓包 Cookie。
#!category=自动任务

[Script]
# 1. 抓 Cookie：只匹配会员中心路径，避免刷首页时反复触发
蜗牛4K抓Cookie = type=http-request,pattern=^https?:\/\/(www\.)?wn4k\.com\/user\/,argument={{{account}}},script-path=https://raw.githubusercontent.com/Viceroy-Dennis/surge-modules/main/wn4k/wn4k_task.js,script-update-interval=0

# 2. 每天 09:14 自动签到（固定 09:14，避开整点并发）
蜗牛4K每日签到 = type=cron,cronexp=14 9 * * *,timeout=60,argument={{{account}}},script-path=https://raw.githubusercontent.com/Viceroy-Dennis/surge-modules/main/wn4k/wn4k_task.js,script-update-interval=0

# 3. 手动跑一次（Surge → 首页 → 脚本 → 点这条）
蜗牛4K手动签到 = type=generic,timeout=60,argument={{{account}}},script-path=https://raw.githubusercontent.com/Viceroy-Dennis/surge-modules/main/wn4k/wn4k_task.js,script-update-interval=0

[MITM]
hostname = %APPEND% wn4k.com, www.wn4k.com
