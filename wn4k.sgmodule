#!name=蜗牛4K每日签到
#!desc=蜗牛 I 4K（wn4k.com）每日签到 · 多账号。两种用法可混用：① 抓包——用哪个账号登录 wn4k.com 并打开一次「会员中心」，那个账号的 Cookie 就自动存进它自己的桶；换账号再登一次即可，多账号依次登录一遍。② 账号密码——在模块参数里填，多个账号用 && 分隔，Cookie 过期会自动重登。每个账号有独立的 Cookie 和独立的签到记录，互不干扰；同账号的两种凭据会自动合并，不会重复签到。
#!arguments=account:none
#!arguments-desc=account：填「账号,密码」走账号密码登录。多个账号用 && 分隔，例：a@qq.com,p1&&b@qq.com,p2&&c@qq.com,p3。留 none 或留空表示只用抓包 Cookie。
#!category=自动任务

[Script]
# 1. 抓 Cookie：只匹配会员中心路径，避免刷首页时反复触发
蜗牛4K抓Cookie = type=http-request,pattern=^https?:\/\/(www\.)?wn4k\.com\/user\/,argument={{{account}}},script-path=https://raw.githubusercontent.com/Viceroy-Dennis/surge-modules/main/wn4k/wn4k_task.js,script-update-interval=0

# 2. 每天 09:14 自动签到（固定 09:14，避开整点并发）
蜗牛4K每日签到 = type=cron,cronexp=14 9 * * *,timeout=120,argument={{{account}}},script-path=https://raw.githubusercontent.com/Viceroy-Dennis/surge-modules/main/wn4k/wn4k_task.js,script-update-interval=0

# 3. 手动跑一次（Surge → 首页 → 脚本 → 点这条）
蜗牛4K手动签到 = type=generic,timeout=120,argument={{{account}}},script-path=https://raw.githubusercontent.com/Viceroy-Dennis/surge-modules/main/wn4k/wn4k_task.js,script-update-interval=0

[MITM]
hostname = %APPEND% wn4k.com, www.wn4k.com
