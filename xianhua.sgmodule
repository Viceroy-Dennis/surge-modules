#!name=三国咸话每日与每周任务
#!desc=每天09:14执行签到、点赞10次、浏览3次、分享1次、周任务与热力竹领奖；支持Surge iOS 5.9+或Mac 5.5+。
#!arguments=capture:咸话抓包
#!arguments-desc=凭据采集默认开启。安装或更新后依次打开微信三国咸话小程序首页、福利页、热力竹页面；采集成功后将参数设为#可停用采集。
#!category=自动任务

[Script]
{{{capture}}} = type=http-request, pattern=^https:\/\/(api-xh|wxforum|xh|hi-gateway|api-forum-act|xianhua)\.sanguosha\.cn\/, requires-body=false, timeout=10, script-path=https://raw.githubusercontent.com/Viceroy-Dennis/surge-modules/main/xianhua/xianhua_capture.js, script-update-interval=0
三国咸话自动任务 = type=cron, cronexp="14 9 * * *", timeout=120, script-path=https://raw.githubusercontent.com/Viceroy-Dennis/surge-modules/main/xianhua/xianhua_task.js, script-update-interval=0
三国咸话手动执行 = type=generic, timeout=120, script-path=https://raw.githubusercontent.com/Viceroy-Dennis/surge-modules/main/xianhua/xianhua_task.js, script-update-interval=0
三国咸话任务列表 = type=generic, argument=mode=list, timeout=15, script-path=https://raw.githubusercontent.com/Viceroy-Dennis/surge-modules/main/xianhua/xianhua_task.js, script-update-interval=0
三国咸话体检测试 = type=generic, timeout=15, script-path=https://raw.githubusercontent.com/Viceroy-Dennis/surge-modules/main/xianhua/xianhua_test.js, script-update-interval=0

[MITM]
hostname = %APPEND% api-xh.sanguosha.cn, wxforum.sanguosha.cn, xh.sanguosha.cn, hi-gateway.sanguosha.cn, api-forum-act.sanguosha.cn, xianhua.sanguosha.cn
